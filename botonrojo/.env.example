# --- Core ---
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_with_openssl_rand_base64_32
APP_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgres://botonrojo:botonrojo@localhost:5432/botonrojo

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Cifrado de credenciales por cliente (Stripe, ActiveCampaign, etc. se ---
# --- conectan por cliente desde /admin/ajustes, no aquí) ---
# Genera una vez con: openssl rand -base64 32
# Si la cambias, todas las credenciales guardadas dejan de poder leerse.
APP_ENCRYPTION_KEY=

# --- Anthropic (Claude) — de plataforma, compartido por todos los clientes ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Generación de imágenes — de plataforma ---
MAGNIFIC_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Email (Resend) — de plataforma ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="Botón Rojo <hola@tu-dominio.com>"

# --- Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=botonrojo
S3_ACCESS_KEY=botonrojo
S3_SECRET_KEY=botonrojo_secret
S3_PUBLIC_URL=http://localhost:9000/botonrojo

# --- GeoIP ---
GEOIP_PROVIDER_URL=https://ip.guide

# --- Dominios personalizados ---
# IP pública del VPS. Se muestra en el admin como destino del registro A
# cuando un cliente conecta un dominio raíz (apex) en vez de un subdominio.
SERVER_IPV4=

# --- Revisión de diseño (servicio de capturas) ---
# Servicio Docker aparte (ver screenshot-service/) que renderiza y fotografía
# la landing recién generada para que Claude la revise. Vacío = se salta la
# revisión, la landing se genera igual.
SCREENSHOT_SERVICE_URL=http://screenshot:4000
SCREENSHOT_SERVICE_TOKEN=
# Cómo llega el servicio de capturas a esta app. En producción (docker
# compose) los dos son contenedores del mismo compose, así que el nombre del
# servicio basta. En local, `pnpm dev` corre en el host, fuera de la red de
# compose — usa http://host.docker.internal:3000 en ese caso.
SCREENSHOT_APP_URL=http://app:3000
# Dónde alcanza el contenedor de capturas al almacenamiento, si no coincide con
# S3_PUBLIC_URL. En docker compose: http://minio:9000/<bucket>. En local con
# `pnpm dev`: http://host.docker.internal:9000/<bucket>. Vacío = usa la pública.
# Si esto está mal, los estáticos salen con el fondo en blanco.
STORAGE_INTERNAL_URL=http://minio:9000/botonrojo
