# --- Core ---
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_with_openssl_rand_base64_32
APP_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgres://botonrojo:botonrojo@localhost:5432/botonrojo

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM="Botón Rojo <hola@tu-dominio.com>"

# --- Storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=botonrojo
S3_ACCESS_KEY=botonrojo
S3_SECRET_KEY=botonrojo_secret
S3_PUBLIC_URL=http://localhost:9000/botonrojo

# --- ActiveCampaign ---
# Find both at: Settings → Developer in your AC account.
ACTIVECAMPAIGN_API_URL=https://YOURACCOUNT.api-us1.com
ACTIVECAMPAIGN_API_KEY=
ACTIVECAMPAIGN_FROM_NAME="Escuela Nómada Digital"
ACTIVECAMPAIGN_FROM_EMAIL=hola@escuelanomadadigital.com

# --- Integrations ---
TELEGRAM_BOT_TOKEN=
NOTION_TOKEN=
YOUTUBE_API_KEY=
META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- GeoIP ---
GEOIP_PROVIDER_URL=https://ip.guide

# --- Dominios personalizados ---
# IP pública del VPS. Se muestra en el admin como destino del registro A
# cuando un cliente conecta un dominio raíz (apex) en vez de un subdominio.
SERVER_IPV4=
